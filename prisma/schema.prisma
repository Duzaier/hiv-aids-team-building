datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  googleId  String?  @unique
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams     Team[]
  auditLogs AuditLog[]
}

model Team {
  id              String             @id @default(cuid())
  slotNumber      Int                @unique
  name            String
  captainName     String?            @default("")
  ownerId         String             @unique
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  outgoingMatches TeamMatchRequest[] @relation("OutgoingMatches")
  incomingMatches TeamMatchRequest[] @relation("IncomingMatches")
  version         Int                @default(1)
  registeredAt    DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model TeamMember {
  id               String   @id @default(cuid())
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name             String
  studentId        String?  @default("")
  email            String?  @default("")
  phone            String?  @default("")
  orderIndex       Int      @default(0)
  isCaptain        Boolean  @default(false)
  isFromIndividual Boolean  @default(false)
  individualId     String?
}

model TeamMatchRequest {
  id          String   @id @default(cuid())
  fromTeamId  String
  fromTeam    Team     @relation("OutgoingMatches", fields: [fromTeamId], references: [id], onDelete: Cascade)
  toTeamId    String
  toTeam      Team     @relation("IncomingMatches", fields: [toTeamId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IndividualRegistration {
  id             String    @id @default(cuid())
  userId         String?   @unique
  name           String
  studentId      String?   @default("")
  email          String
  phone          String?
  assignedTeamId String?
  assignedSlot   Int?
  assignedAt     DateTime?
  registeredAt   DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  adminId        String
  admin          User     @relation(fields: [adminId], references: [id])
  action         String
  targetSlot     Int
  targetTeamName String
  details        String?
  createdAt      DateTime @default(now())
}